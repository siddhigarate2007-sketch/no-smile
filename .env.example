# Environment Mode
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL for CORS & redirects
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# Local Docker or standard local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow?schema=public

# Session and Cookie Security
COOKIE_SECRET=devflow_super_secret_cookie_signing_key_32bytes_min
SESSION_SECRET=devflow_session_encryption_secret_key_32bytes_min

# Security settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_DAYS=7
